{
  "name": "edison-mandir-kiosk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "nam": "vite --open /nam.html --port 5177",
    "santo": "vite --open /santo.html --port 5178",
    "build": "tsc -b && vite build && node scripts/maybe-nam-index.mjs",
    "build:nam": "tsc -b && vite build && cp dist/nam.html dist/index.html",
    "build:santo": "tsc -b && vite build && cp dist/santo.html dist/index.html",
    "start": "node server.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.2.1",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
